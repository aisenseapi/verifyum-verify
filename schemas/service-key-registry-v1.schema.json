{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifyum.com/schema/service-key-registry-v1.json",
  "title": "Verifyum service key registry version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated_at",
    "keys"
  ],
  "properties": {
    "schema": {
      "const": "https://verifyum.com/schema/service-key-registry-v1.json"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "algorithm",
          "key_id",
          "network",
          "public_key",
          "status",
          "created_at"
        ],
        "properties": {
          "algorithm": {
            "const": "ed25519"
          },
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "network": {
            "enum": [
              "devnet",
              "mainnet-beta"
            ]
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
